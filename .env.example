PORT=4318
# Absolute paths supported. Relative paths are resolved from repository root.
CRAWL_DATA_DIR=./data
# Full ranking pagination budget (milliseconds, maximum 600000).
CRAWL_COLLECTOR_TIMEOUT_MS=600000
CRAWL_CDP_URL=http://127.0.0.1:19327
CRAWL_MODEL_URL=http://127.0.0.1:11434
HOTSPOT_VISION_MODEL=qwen3-vl:8b-instruct
# Optional already-installed local text-analysis model; empty reuses the visual model.
# This setting never downloads a model or enables a paid/cloud fallback.
HOTSPOT_ANALYSIS_MODEL=
# setup.mjs writes this device's venv/model paths only on first setup.
CRAWL_PYTHON=python3
# Existing faster-whisper local directory or cached model name; no automatic download.
CRAWL_WHISPER_MODEL=./models/faster-whisper-small
# Optional cache directory containing the existing faster-whisper model.
CRAWL_WHISPER_CACHE=
TENCENT_DOCS_TOKEN=
# Configure through the web UI or here; never commit your real destination.
TENCENT_DOCS_FILE_ID=
TENCENT_DOCS_URL=
# Paid Redfox source. User must click 开始查询; switching filters is local-only.
CRAWL_GAME_SOURCE=redfox
CRAWL_HOTSPOT_SOURCE=redfox
# Background executor consumes user-confirmed queries; this does not auto-query.
CRAWL_SEARCH_MODE=automatic
# Get your own key: https://redfox.hk/dashboard/keys
REDFOX_API_KEY=
